{
  "key": "eclipse",
  "name": "Eclipse Banner",
  "category": "Medals",
  "resolution": [
    1400,
    250
  ],
  "settings": {
    "backgroundType": {
      "name": "Background Type",
      "type": "enum",
      "values": [
        {
          "key": "club",
          "name": "Club"
        },
        {
          "key": "gradient",
          "name": "Gradient"
        }
      ],
      "default": "club",
      "output": {
        "type": "css-class",
        "prefix": "dyn-backgroundType-"
      }
    },
    "backgroundGradient": {
      "name": "Background Gradient",
      "type": "colour-gradient",
      "default": [
        "#ffaa66",
        "#ff66aa"
      ],
      "showOn": {
        "backgroundType": "gradient"
      },
      "output": {
        "type": "css-variable"
      }
    },
    "backgroundGradientAngle": {
      "name": "Background Gradient Angle",
      "type": "range",
      "values": {
        "start": 0,
        "end": 360
      },
      "default": 0,
      "showOn": {
        "backgroundType": "gradient"
      },
      "output": {
        "type": "css-variable",
        "suffix": "deg"
      }
    }
  }
}

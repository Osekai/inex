DEV=true
INSTANCE="dev"
URL="http://0.0.0.0:19242"

# osu! oauth, redirect URI will be URL . /oauth (e.g. http://0.0.0.0:19242/oauth)
CLIENT_ID="31799"
CLIENT_SECRET=""

# database connection
DATABASE_NAME="inex"
DATABASE_USERNAME="root"
DATABASE_PASSWORD="password"
DATABASE_HOSTNAME="127.0.0.1"

# legacy "eclipse" database creds, will not be connected unless you use the "Eclipse.*" tasks
ETI_DATABASE_NAME="osekai"
ETI_DATABASE_USERNAME="root"
ETI_DATABASE_PASSWORD="password"
ETI_DATABASE_HOSTNAME="localhost"

USE_MEMCACHE=false # you should REALLY set this up. install memcached and enable if you know how. site will be extremely slow otherwise!
GITHUB_API_KEY="" # for deploy, not needed in dev

# MEDAL MODERATION
# this is for some older moderation stuff, still used, not needed for dev
MOD_WEBHOOK_EDITS=""
MOD_WEBHOOK=""

# MODERATION SYSTEM
# leave off for dev unless you're working on AMPRA
USE_AMPRA=false
AMPRA_TOKEN=""
AMPRA_SERVER="1207783400178458634"

# SCRIPTS26
# so osekai can tell it to update user data. if it's not present nothing will break but it's ui will be missing
SCRIPTS_API_URL="http://127.0.0.1:3000/" # public api (on prod its https://scripts.osekai.net, you can set it to this to see the dev UI maybe)
SCRIPTS26_ADDRESS="127.0.0.1:3000" # private api
SCRIPTS26_PASSWORD="" # admin password for scripts26

# S3 Connection
# this is COMPLETELY UNUSED in Osekai right now, but it's left here for the future (likely for snapshots)
# you can leave these blank.
BUCKET_NAME=""
CLOUDFLARE_TOKEN=""
BUCKET_ENDPOINT=""
ACCESS_KEY_ID=""
ACCESS_KEY_SECRET=""
S3_URL_PATH=""
